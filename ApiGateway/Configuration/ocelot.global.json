{
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7000",

    "RequestIdKey": "Request-Id",

    "ServiceDiscoveryProvider": {
      "Type": "Configuration"
    },

    "RateLimitOptions": {
      "DisableRateLimitHeaders": false,
      "QuotaExceededMessage": "Too many requests. Please try again later.",
      "HttpStatusCode": 429
    }
  }
}